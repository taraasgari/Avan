# Copy to .env.production on the server. NEVER commit the real file.
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=REPLACE_WITH_AT_LEAST_64_RANDOM_CHARACTERS
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=avan.example.com,www.avan.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://avan.example.com,https://www.avan.example.com
DJANGO_ADMIN_URL=control-REPLACE-ME/

POSTGRES_DB=avan
POSTGRES_USER=avan
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_HOST=db
POSTGRES_PORT=5432

ENABLE_REDIS_CACHE=1
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

AVAN_PRODUCTION_SECURE=1
AVAN_BEHIND_HTTPS_PROXY=1
# Enable only when X-Forwarded-For comes exclusively from your trusted reverse proxy.
AVAN_TRUST_X_FORWARDED_FOR=1
AVAN_CSP_ENFORCE=1
AVAN_HSTS_SECONDS=31536000
AVAN_JSON_LOGS=1
AVAN_LOG_LEVEL=INFO
AVAN_MANIFEST_STATIC=1
AVAN_METRICS_TOKEN=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
AVAN_RELEASE=production
AVAN_COMMIT_SHA=

AVAN_HTTP_PORT=8080
AVAN_GUNICORN_WORKERS=3
AVAN_GUNICORN_THREADS=2
AVAN_CELERY_CONCURRENCY=2

AVAN_BRAND_NAME=AVAN
ORDER_RESERVATION_MINUTES=20
DEFAULT_SHIPPING_AMOUNT=0
