DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-before-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://localhost:8080

POSTGRES_DB=avan
POSTGRES_USER=avan
POSTGRES_PASSWORD=avan-dev-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
ENABLE_REDIS_CACHE=0

AVAN_BRAND_NAME=AVAN
AVAN_PRIMARY_COLOR=#D50000
ORDER_RESERVATION_MINUTES=20
DEFAULT_SHIPPING_AMOUNT=0

# Stage 12 security. Keep production switches OFF on localhost.
AVAN_PRODUCTION_SECURE=0
AVAN_BEHIND_HTTPS_PROXY=0
AVAN_TRUST_X_FORWARDED_FOR=0
AVAN_CSP_ENFORCE=0
AVAN_HSTS_SECONDS=31536000
AVAN_LOGIN_FAILURE_LIMIT=7
AVAN_LOGIN_WINDOW_SECONDS=900
AVAN_MAX_IMAGE_PIXELS=40000000
