DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=change-me-before-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

POSTGRES_DB=avan
POSTGRES_USER=avan
POSTGRES_PASSWORD=avan-dev-only
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Core shopping must not depend on Redis/cache availability.
ENABLE_REDIS_CACHE=0

AVAN_BRAND_NAME=AVAN
AVAN_PRIMARY_COLOR=#D50000

# Commerce
ORDER_RESERVATION_MINUTES=20
DEFAULT_SHIPPING_AMOUNT=0
